{
  "name": "primate-vision-client",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source reference client for the Primate Vision public API — upload a video, ask a question, see the answer.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n mint,web \"node server/mint.js\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "node server/mint.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsc -b --noEmit && echo 'typecheck clean'"
  },
  "dependencies": {
    "@primate-intelligence/sdk": "file:vendor/primate-intelligence-sdk-0.1.0.tgz",
    "@primate-intelligence/vision-react": "file:vendor/primate-intelligence-vision-react-0.1.0.tgz",
    "express": "^4.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
